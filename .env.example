# ---------- Backblaze B2 (S3-compatible API) ----------
# B2 console -> Buckets -> your bucket shows the "Endpoint" (e.g. s3.us-west-004.backblazeb2.com)
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# Optional: derived from the endpoint when omitted (the "us-west-004" part)
B2_REGION=
# B2 console -> Application Keys -> "keyID" and "applicationKey" (shown once at creation)
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=

# ---------- Supabase auth ----------
# Project Settings -> API. Leave both empty to run without login (guest mode).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------- Server ----------
PORT=3001
